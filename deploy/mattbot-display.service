[Unit]
Description=Mattbot touch display
After=network.target graphical.target
Wants=graphical.target

[Service]
Type=simple
User=jetson
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/jetson/.Xauthority
WorkingDirectory=/opt/mattbot/display
ExecStart=/opt/mattbot/display/venv/bin/python3 display_app.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
