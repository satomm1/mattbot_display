# Legacy system service — install.sh now uses a user service instead.
# User unit: ~/.config/systemd/user/mattbot-display.service
#
# Why: system services cannot reliably access the desktop X session
# (TclError: couldn't connect to display ":0"). User services run in
# the logged-in desktop session and inherit correct DISPLAY/XAUTHORITY.

[Unit]
Description=Mattbot touch display (deprecated — use user service)
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=REPO_PATH
ExecStart=REPO_PATH/scripts/run_display_service.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
